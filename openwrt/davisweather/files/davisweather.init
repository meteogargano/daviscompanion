USE_PROCD=1
START=99
STOP=15

CONF="davisweather"
PROG="/usr/bin/davisweather"

start_service() {
	config_load "$CONF"

	local enabled
	config_get_bool enabled "general" "enabled" "0"
	[ "$enabled" -eq "1" ] || return 1

	local port baud interval bucket buffering db_path api_url api_key
	config_get port "general" "port"
	config_get baud "general" "baud" "19200"
	config_get interval "general" "interval" "2m"
	config_get bucket "general" "bucket" "0.2mm"
	config_get buffering "general" "buffering" "none"
	config_get db_path "general" "db_path" "/etc/davisweather/weather.db"
	config_get api_url "voria2" "api_url"
	config_get api_key "voria2" "api_key"

	if [ -z "$port" ] || [ -z "$api_url" ] || [ -z "$api_key" ]; then
		logger -t "$CONF" "missing required options (port/api_url/api_key), not starting"
		return 1
	fi

	procd_open_instance "$CONF"
	procd_set_param command "$PROG"
	procd_append_param command --port "$port"
	procd_append_param command --baud "$baud"
	procd_append_param command --api-url "$api_url"
	procd_append_param command --api-key "$api_key"
	procd_append_param command --interval "$interval"
	procd_append_param command --bucket "$bucket"
	if [ "$buffering" = "sqlite" ]; then
		procd_append_param command --db "$db_path"
	else
		procd_append_param command --no-db
	fi
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
